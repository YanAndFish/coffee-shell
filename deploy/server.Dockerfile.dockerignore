# Build context for deploy/server.Dockerfile (BuildKit picks this file up by its name).
# Everything is out except the Node workspace the backend is built from.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!packages/**
!apps/server/**
!deploy/server/**
**/node_modules
**/dist
**/dist-seed
**/.data
**/*.db
**/.env*
apps/server/src/generated
